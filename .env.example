# Qloo Taste AI API Configuration
QLOO_API_KEY=your_qloo_hackathon_api_key_here
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Outbound rate limiting for Qloo API (protects the hackathon key quota).
# Sustained rate = QLOO_RATE_LIMIT requests per QLOO_RATE_WINDOW_MS.
QLOO_RATE_LIMIT=5
QLOO_RATE_WINDOW_MS=1000
QLOO_MAX_CONCURRENCY=2
QLOO_RATE_QUEUE_MAX=50
# Exponential backoff for temporary failures (network errors, HTTP 429/503).
# Total attempts = 1 initial + QLOO_MAX_RETRIES (default => 3 attempts).
QLOO_MAX_RETRIES=2
QLOO_RETRY_BASE_MS=500
QLOO_RETRY_MAX_MS=30000
# Response cache for Qloo answers (memory + disk; saves key quota in dev).
QLOO_CACHE_ENABLED=true
QLOO_CACHE_TTL_MS=300000
# Long-lived TTL (24h) for repeated requests to entities and tags.
QLOO_CACHE_TTL_ENTITIES_MS=86400000
QLOO_CACHE_DIR=.cache/qloo
QLOO_CACHE_MAX_ENTRIES=500

# Mock mode: serve hand-recorded static Qloo response fixtures
# (server/src/mocks/qlooFixtures.js) instead of hitting the network —
# autonomous offline operation, zero key quota, no cache pollution.
MOCK_MODE=false

# Server Configuration
PORT=3000
NODE_ENV=development
# System event logging: debug|info|warn|error|silent (stderr, one line
# per event, secrets redacted — see server/src/logger.js).
LOG_LEVEL=info
