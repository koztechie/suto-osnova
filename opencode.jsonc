{
  "$schema": "https://opencode.ai/config.json",

  // Мінімальні проєктні налаштування.
  // Не дублюйте великі масиви з глобального конфігу без потреби,
  // бо конфліктні поля можуть перезаписати глобальні значення.

  "worktree": {
    "directory": "../worktrees"
  },

  // Використовуйте, якщо в проєкті є папка docs,
  // яку агент може використовувати як довідковий контекст.
  "references": {
    "docs": {
      "path": "./docs",
      "description": "Project documentation and terminology"
    }
  }
}
